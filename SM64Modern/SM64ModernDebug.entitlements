<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sustained execution requires a provisioned App ID. M2's local Debug
         signature stays debuggable while Release retains that entitlement. -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
